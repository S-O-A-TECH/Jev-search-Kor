{
  "name": "jev-search-kor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한국어 특화 Tavily·네이버 병렬 검색 및 Jev 근거 평가 엔진",
  "scripts": {
    "dev": "vite dev --port 3030",
    "generate-routes": "tsr generate",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview --port 3030",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --env-file .dev.vars.example",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "simple-icons": "^16.31.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/router-cli": "1.167.19",
    "@types/node": "22.14.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "5.8.3",
    "vite": "8.1.5",
    "vitest": "^3.2.4",
    "wrangler": "4.111.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "MIT",
  "homepage": "https://github.com/S-O-A-TECH/Jev-search-Kor",
  "repository": {
    "type": "git",
    "url": "https://github.com/S-O-A-TECH/Jev-search-Kor.git"
  },
  "bugs": {
    "url": "https://github.com/S-O-A-TECH/Jev-search-Kor/issues"
  }
}
